# Copy to .env in the repo root. `npm run dev` and `npm start` load it if present.
# In production the values live in /etc/mesh-backend/env (see docs/DEPLOYMENT.md).
# Quote any value containing `#`: unquoted, the rest of the line is a comment.

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Caddy proxies to this address in production; keep HOST on loopback.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Serves the API console at /dev. Development only; leave off in production.
DEV_CONSOLE=false

# ── Storage ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/mesh.db

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# Public URL of this API.
AUTH_URL=http://localhost:3000
# The website origin allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

# ── Ingest (leave MQTT_URL empty to run without it) ──────────────────────────
MQTT_URL=
MQTT_USERNAME=mesh-backend
MQTT_PASSWORD=
MQTT_TOPIC="msh/US/2/e/#"
# The mesh channel's private AES key (base64, 16 or 32 bytes). Default keys are rejected.
MESH_CHANNEL_KEY=

# ── Node status and system alerts ────────────────────────────────────────────
STATUS_DEGRADED_MIN=30
STATUS_OFFLINE_MIN=120
LOW_BATTERY_PCT=20
# How far back link observations count toward the map.
LINK_WINDOW_MIN=1440
