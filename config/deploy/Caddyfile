# /etc/caddy/Caddyfile — HTTPS termination and reverse proxy for the API.
# Caddy obtains and renews the certificate automatically.

{
	servers {
		# Cloudflare proxies api.meshfiredetection.org, so its edge addresses are
		# the only peers whose forwarding headers may be believed. Anything else
		# reaching this origin gets its headers discarded and is judged by its
		# own address. Refresh from https://www.cloudflare.com/ips/ if Cloudflare
		# publishes a change; they are stable for years at a time.
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

api.meshfiredetection.org {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		# {client_ip} is the caller resolved through the trusted hop above, so
		# behind Cloudflare it is the visitor rather than an edge address every
		# visitor shares. Setting the header here overwrites whatever arrived,
		# which matters because this origin is directly reachable: the grey-cloud
		# mqtt.meshfiredetection.org record publishes its address by design.
		header_up X-Real-IP {client_ip}
	}

	log {
		output file /var/log/caddy/api.log
	}
}
