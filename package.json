{
    "name": "mesh-fire-detection-backend",
    "private": true,
    "license": "MIT",
    "version": "0.2.1",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "imports": {
        "#src/*": {
            "development": "./src/*.ts",
            "default": "./dist/*.js"
        },
        "#tests/*": "./tests/*.ts"
    },
    "scripts": {
        "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/index.ts",
        "build": "tsc -p config/build/tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "prepare": "node config/build/installHooks.mjs",
        "check": "npm run check:types && npm run lint && npm test && npm run build",
        "check:types": "tsc -p tsconfig.json --noEmit",
        "check:contract": "node config/build/checkNetworkContract.mjs",
        "check:runtime": "node config/build/checkRuntime.mjs",
        "test": "vitest run --config config/build/vitest.config.ts",
        "test:watch": "vitest --config config/build/vitest.config.ts",
        "lint": "npm run lint:format && npm run lint:structure && npm run lint:js && npm run lint:deadcode",
        "lint:format": "prettier --config config/lint/.prettierrc --check . --log-level warn --ignore-path config/lint/.prettierignore",
        "lint:structure": "tsx config/lint/checkStructure.ts",
        "lint:js": "eslint --config config/lint/eslint.config.mjs .",
        "lint:deadcode": "knip --config config/lint/knip.json --tsConfig config/build/tsconfig.build.json",
        "fix": "npm run fix:format && npm run fix:js",
        "fix:format": "prettier --config config/lint/.prettierrc --write . --log-level warn --ignore-path config/lint/.prettierignore",
        "fix:js": "eslint --config config/lint/eslint.config.mjs . --fix",
        "deps:updates": "npx npm-check-updates -u",
        "db:generate": "drizzle-kit generate --config config/build/drizzle.config.ts",
        "user:create-admin": "node --env-file-if-exists=.env dist/app/createAdmin.js"
    },
    "lint-staged": {
        "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --config config/lint/.prettierrc --check --ignore-path config/lint/.prettierignore",
        "{src,config,tests}/**/*.{ts,js,mjs,cjs}": "eslint --config config/lint/eslint.config.mjs"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.17.0",
        "@hono/node-server": "^2.1.6",
        "@meshtastic/protobufs": "^2.8.0",
        "@scalar/hono-api-reference": "^0.12.18",
        "better-auth": "^1.7.18",
        "better-sqlite3": "^13.0.3",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.17",
        "hono-openapi": "^1.5.0",
        "hono-rate-limiter": "^0.5.4",
        "mqtt": "^5.16.1",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24.19.2",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.0",
        "eslint-plugin-unicorn": "^75.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "knip": "^6.44.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    }
}
